# Copy this file to .env.local for local development.
# .env.local is gitignored. Never commit real keys.

# Stripe — get keys from https://dashboard.stripe.com/apikeys
# Use sk_test_... locally; set sk_live_... only in Vercel project env vars.
STRIPE_SECRET_KEY=sk_test_replace_me

# X (Twitter) Ads — server-side Conversions API token.
# Never commit the real token; set it in .env.local and Vercel env vars.
X_PIXEL_TOKEN=replace_me

# Stripe webhook signing secret (whsec_...) from the Stripe dashboard or
# `stripe listen`. Required to verify webhook authenticity.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Resend — get an API key from https://resend.com/api-keys
# Powers the contact form and the newsletter opt-in. If unset, both routes
# log submissions to the server console instead of sending/saving.
RESEND_API_KEY=re_replace_me

# Contact form delivery addresses.
CONTACT_TO_EMAIL=you@yourdomain.com
CONTACT_FROM_EMAIL=Sitepulse <noreply@yourdomain.com>

# Neon Postgres — stores newsletter opt-ins (table: subscribers).
# Provisioned via the Vercel Storage → Neon integration, which injects
# DATABASE_URL into Production/Preview automatically. If unset (local dev),
# the /api/subscribe route logs opt-ins to the server console instead.
DATABASE_URL=
