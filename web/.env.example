# Copy this file to .env.local for local development.
# .env.local is gitignored. Never commit real keys.

# Stripe — get keys from https://dashboard.stripe.com/apikeys
# Use sk_test_... locally; set sk_live_... only in Vercel project env vars.
STRIPE_SECRET_KEY=sk_test_replace_me

# X (Twitter) Ads — server-side Conversions API token.
# Never commit the real token; set it in .env.local and Vercel env vars.
X_PIXEL_TOKEN=replace_me

# Stripe webhook signing secret (whsec_...) from the Stripe dashboard or
# `stripe listen`. Required to verify webhook authenticity.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Field guide (email-gated PDF download). Any long random string; it signs the
# cookie that unlocks /api/field-guide/download.
# Generate with: openssl rand -hex 32
FIELD_GUIDE_SECRET=replace_me

# Resend — powers the contact form and the field-guide lead notification.
RESEND_API_KEY=re_replace_me
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=Sitepulse <hello@yourdomain.com>
