# Copy this file to .env.local for local development.
# .env.local is gitignored. Never commit real keys.

# Stripe — get keys from https://dashboard.stripe.com/apikeys
# Use sk_test_... locally; set sk_live_... only in Vercel project env vars.
STRIPE_SECRET_KEY=sk_test_replace_me

# X (Twitter) Ads — server-side Conversions API token.
# Never commit the real token; set it in .env.local and Vercel env vars.
# The browser pixel ID `rdcan` is already hardcoded in src/app/layout.tsx.
X_PIXEL_TOKEN=replace_me

# --- Ad attribution (all optional; unset = no-op, site behaves as before) ---

# Meta Pixel ID from Events Manager. Public, inlined at build time.
# Numeric, e.g. 123456789012345. Leave blank until you have one.
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API token (server-only). Events Manager → Settings →
# Generate access token. Required for CAPI; pixel still works without it.
META_CAPI_ACCESS_TOKEN=

# Optional. When set, events show in Meta's Test Events view and are not
# used for ad optimization. Remove before going live.
META_CAPI_TEST_EVENT_CODE=

# PostHog project API key (phc_...). Unset = PostHog is not loaded.
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog ingest host. US cloud default below; EU is https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Set to 1 to log pixel / PostHog / CAPI calls in the browser console.
NEXT_PUBLIC_TRACKING_DEBUG=

# Stripe webhook signing secret (whsec_...) from the Stripe dashboard or
# `stripe listen`. Required to verify webhook authenticity.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Field guide (email-gated PDF download). Any long random string; it signs the
# cookie that unlocks /api/field-guide/download.
# Generate with: openssl rand -hex 32
FIELD_GUIDE_SECRET=replace_me

# Resend — powers the contact form and the field-guide lead notification.
RESEND_API_KEY=re_replace_me
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=Sitepulse <hello@yourdomain.com>
